ANTHROPIC_API_KEY=sk-ant-...

AUTO_APPLIER_DATA_DIR=data
AUTO_APPLIER_DB_URL=sqlite:///data/auto_applier.sqlite

TAILOR_MODEL=claude-sonnet-4-6
SCORE_MODEL=claude-haiku-4-5

ANTHROPIC_DAILY_BUDGET_USD=5.00
TAILOR_DAILY_LIMIT=30

APPROVAL_HOST=127.0.0.1
APPROVAL_PORT=8765

LINKEDIN_LI_AT=
INDEED_ENABLED=false
LINKEDIN_ENABLED=false

# Set to true to run the auto-submit browser headless (no UI). Default false
# so you can watch + intervene during early use.
PLAYWRIGHT_HEADLESS=false

# How auto-submit handles open-ended essay questions.
#   flag        — bail to needs_human, you fill in by hand
#   attempt     — write a grounded answer using only profile facts; blank if no material
#   aggressive  — always answer, extrapolate plausibly within domain/seniority
SUBMIT_ESSAY_MODE=attempt

# Don't submit to a company you've already applied to within this many days.
# Set to 0 to disable.
SUBMIT_PER_COMPANY_COOLDOWN_DAYS=14

# IMAP settings for the outcome-tracker. Outlook / live.com / hotmail use
# imap-mail.outlook.com (or outlook.office365.com), Gmail uses imap.gmail.com.
# IMAP_PASSWORD must be an App Password — see README. Plain account passwords
# don't work with modern providers.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_LOOKBACK_DAYS=30
